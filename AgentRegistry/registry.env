export A2X_REGISTRY_HOME=./A2X-registry/build_test/registry_home
export A2X_REGISTRY_MODE=appliance
export A2X_REGISTRY_DB_KIND=memory
export A2X_REGISTRY_BIND=127.0.0.1
export A2X_REGISTRY_PORT=8000

# ── etcd 后端（A2X_REGISTRY_DB_KIND=etcd 时生效，且要求 MODE=appliance） ──
# export A2X_REGISTRY_DB_KIND=etcd
# etcd 单 endpoint（必填）；未配证书必须 http://，配齐证书必须 https://
# export A2X_REGISTRY_DB_ENDPOINT=http://127.0.0.1:2379
# key 前缀（默认 a2x-registry）
# export A2X_REGISTRY_ETCD_NAMESPACE=a2x-registry
# mTLS 三件套：三者配齐 -> https + 双向 TLS；全空 -> http 不认证（部分配置会被拒绝）
# export A2X_REGISTRY_ETCD_TLS_CA=
# export A2X_REGISTRY_ETCD_TLS_CERT=
# export A2X_REGISTRY_ETCD_TLS_KEY=
