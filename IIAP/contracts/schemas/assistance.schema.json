{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openjiuwen.org/iiap/0.1/assistance.schema.json",
  "title": "IIAP Assistance",
  "oneOf": [
    {
      "type": "object", "additionalProperties": false,
      "required": ["type", "iiapVersion", "requestId", "packetId", "decisionId", "surfaceInstanceId", "topic", "language"],
      "properties": {
        "type": {"const": "iiap.assistance.request"}, "iiapVersion": {"const": "0.1"}, "requestId": {"type": "string"},
        "packetId": {"type": "string"}, "decisionId": {"type": "string"}, "surfaceInstanceId": {"type": "string"},
        "topic": {"enum": ["compare_options", "explain_rules", "fix_block", "save_progress"]},
        "language": {"type": "string"}
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["type", "iiapVersion", "requestId", "message"],
      "properties": {
        "type": {"const": "iiap.assistance.response"}, "iiapVersion": {"const": "0.1"}, "requestId": {"type": "string"},
        "message": {"type": "string", "minLength": 1, "maxLength": 4096}
      }
    }
  ]
}
