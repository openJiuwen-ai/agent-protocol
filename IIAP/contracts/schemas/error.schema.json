{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openjiuwen.org/iiap/0.1/error.schema.json",
  "title": "IIAP Error",
  "type": "object", "additionalProperties": false,
  "required": ["type", "iiapVersion", "code", "message", "retryable"],
  "properties": {
    "type": {"const": "iiap.error"},
    "iiapVersion": {"const": "0.1"},
    "code": {"enum": ["INVALID_PACKET", "PRIVACY_REJECTED", "PACKET_TOO_LARGE", "MODEL_TIMEOUT", "INVALID_DECISION", "STALE_SURFACE", "UNSAFE_SUGGESTION", "ASSISTANCE_UNSAFE_OUTPUT", "TRANSPORT_ERROR"]},
    "message": {"type": "string", "maxLength": 512}, "retryable": {"type": "boolean"},
    "requestId": {"type": "string"}
  }
}
